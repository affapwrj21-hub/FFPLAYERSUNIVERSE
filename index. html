<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080606">
<title>Free Fire Player Database</title>
<style>
:root{--red:#f01925;--deep:#310609;--bg:#070606;--card:#100b0c;--muted:#aaa}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;color:#fff;font-family:Arial,Helvetica,sans-serif;background:
 radial-gradient(ellipse at 50% 10%,rgba(104,5,13,.48),transparent 42%),
 radial-gradient(ellipse at 0% 55%,rgba(100,0,10,.25),transparent 35%),
 radial-gradient(ellipse at 100% 80%,rgba(100,0,10,.22),transparent 35%),#070606;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;opacity:.28;background:
 repeating-linear-gradient(125deg,transparent 0 110px,rgba(255,0,20,.09) 112px,transparent 116px 230px)}
a{color:inherit;text-decoration:none}
.topbar{height:68px;border-bottom:1px solid rgba(255,30,40,.3);background:rgba(5,5,5,.88);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,7vw,100px);position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}
.brand{font-size:21px;font-weight:900;color:#ff2935;letter-spacing:-1px}.brand span{color:#fff}
nav{display:flex;gap:clamp(12px,3vw,38px);align-items:center;color:#c7c7c7;font-size:14px;font-weight:700}
nav a:hover{color:#ff303b}
.follow{border:1px solid var(--red);border-radius:22px;padding:10px 18px;color:#fff;box-shadow:0 0 15px #f0192533}
main{width:min(1100px,92%);margin:0 auto;padding:30px 0 24px}
.hero{height:145px;border:1px solid #ed1726;border-radius:15px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;background:linear-gradient(100deg,rgba(50,0,5,.92),rgba(5,5,5,.97) 48%,rgba(55,0,6,.92));box-shadow:0 0 24px #ed172633,inset 0 0 28px #ed17261c}
.hero:before,.hero:after{content:"";position:absolute;top:-30px;width:26%;height:210px;background:linear-gradient(135deg,transparent 38%,rgba(255,0,20,.24) 39%,transparent 42%,transparent 52%,rgba(255,0,20,.18) 53%,transparent 56%);transform:skewX(-24deg)}
.hero:before{left:-4%}.hero:after{right:-4%;transform:scaleX(-1) skewX(-24deg)}
.crown{color:#f51e2c;font-size:26px;line-height:1;margin-bottom:5px;text-shadow:0 0 14px #f01925}
.hero h1{position:relative;z-index:1;margin:0;font-size:clamp(25px,5vw,48px);font-weight:1000;font-style:italic;letter-spacing:1px;text-shadow:0 2px 0 #8b1018,0 0 20px #f0192544}
.hero h1 span{color:#f32431}
.hero p{position:relative;z-index:1;margin:0;color:#f32431;font-size:clamp(15px,2.8vw,27px);font-weight:1000;font-style:italic;letter-spacing:1px}
.search-wrap{width:min(575px,92%);margin:22px auto 38px;display:flex;height:48px;border:1px solid #5b5555;border-radius:14px;overflow:hidden;background:#090909;box-shadow:0 0 18px #000}
.search-wrap input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#fff;padding:0 16px;font-size:14px}
.search-wrap button{width:58px;border:0;background:#ed1726;color:white;font-size:21px;cursor:pointer}
.section-title{display:flex;align-items:center;justify-content:center;gap:16px;margin:0 auto 25px;text-align:center}
.section-title:before,.section-title:after{content:"";height:2px;max-width:115px;flex:1;background:linear-gradient(90deg,transparent,#e71927)}
.section-title:after{transform:scaleX(-1)}
.section-title h2{margin:0;padding:10px 32px;border:1px solid #e71927;border-radius:5px;background:linear-gradient(90deg,#280609,#100809,#280609);font-size:clamp(16px,2.8vw,23px);font-style:italic;letter-spacing:1px;box-shadow:0 0 17px #e7192733}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.player{background:linear-gradient(150deg,#1b1011,#080707 72%);border:1px solid #75121a;border-radius:11px;padding:8px;box-shadow:0 7px 18px #0009,0 0 12px #e7192718;transition:transform .22s,border-color .22s,box-shadow .22s}
.player:hover{transform:translateY(-5px);border-color:#ff2635;box-shadow:0 8px 24px #e7192740}
.photo{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;border-radius:7px;background:linear-gradient(135deg,#30090d,#090909);border:1px solid #3d161a}
.player h3{margin:10px 2px 9px;text-align:center;font-size:clamp(12px,1.6vw,16px);font-weight:900;font-style:italic;letter-spacing:.5px}
.tiktok{display:block;width:max-content;max-width:100%;margin:0 auto 2px;padding:8px 13px;border:1px solid #f01925;border-radius:20px;font-size:12px;color:#fff;text-align:center;transition:.2s}
.tiktok:hover{background:#e71927;box-shadow:0 0 15px #e7192777}
.empty{display:none;text-align:center;color:#aaa;padding:30px}
footer{margin-top:45px;border-top:1px solid #6b1119;padding:20px 8px;text-align:center;color:#ed2633;font-size:12px;font-weight:800;letter-spacing:4px}
@media(max-width:650px){.topbar{height:58px;padding:0 14px}.brand{font-size:17px}nav{gap:12px;font-size:12px}nav a:nth-child(3){display:none}.follow{padding:8px 10px;font-size:11px}main{width:94%;padding-top:20px}.hero{height:105px}.search-wrap{margin:18px auto 28px;height:44px}.grid{gap:10px}.player{padding:5px;border-radius:8px}.player h3{margin:7px 1px;font-size:11px}.tiktok{font-size:10px;padding:7px 8px}.section-title{gap:8px;margin-bottom:16px}.section-title h2{padding:8px 12px}footer{letter-spacing:2px;font-size:10px}}
@media(max-width:360px){.grid{gap:7px}.player{padding:4px}.tiktok{font-size:9px;padding:6px 5px}}
</style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="#">✦ <span>Garena</span></a>
  <nav><a href="#">⌂ Beranda</a><a href="#players">♟ Pemain</a><a href="#about">ⓘ About</a><a href="#contact">✉ Kontak</a></nav>
  <a class="follow" href="https://www.tiktok.com/" target="_blank" rel="noopener">♪ Follow TikTok</a>
</header>
<main>
  <section class="hero">
    <div class="crown">♛</div>
    <h1>FREE <span>F</span>IRE</h1>
    <p>PLAYER DATABASE</p>
  </section>
  <form class="search-wrap" onsubmit="return false">
    <input id="search" type="search" placeholder="⌕  Cari nama pemain..." aria-label="Cari nama pemain">
    <button type="button" aria-label="Cari">⌕</button>
  </form>
  <section id="players">
    <div class="section-title"><h2>PLAYER COLLECTION</h2></div>
    <div class="grid" id="grid">
      <article class="player" data-name="cybila nailong"><img class="photo" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=600&h=600&fit=crop" alt="Foto pemain CYBILA NAILONG"><h3>CYBILA NAILONG</h3><a class="tiktok" href="https://www.tiktok.com/@cybilalovie?_r=1&_t=ZS-9BSUx7wSoNR" target="_blank" rel="noopener">♪ &nbsp; Lihat TikTok →</a></article>
      <article class="player" data-name="evos mr05"><img class="photo" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600&h=600&fit=crop" alt="Foto pemain EVOS MR05"><h3>EVOS MR05</h3><a class="tiktok" href="https://www.tiktok.com/" target="_blank" rel="noopener">♪ &nbsp; Lihat TikTok →</a></article>
      <article class="player" data-name="btr raone"><img class="photo" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=600&fit=crop" alt="Foto pemain BTR Raone"><h3>BTR RAONE</h3><a class="tiktok" href="https://www.tiktok.com/" target="_blank" rel="noopener">♪ &nbsp; Lihat TikTok →</a></article>
      <article class="player" data-name="onic jars"><img class="photo" src="https://images.unsplash.com/photo-1507591064344-4c6ce005b128?w=600&h=600&fit=crop" alt="Foto pemain ONIC Jars"><h3>ONIC JARS</h3><a class="tiktok" href="https://www.tiktok.com/" target="_blank" rel="noopener">♪ &nbsp; Lihat TikTok →</a></article>
      <article class="player" data-name="rrq levi"><img class="photo" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600&h=600&fit=crop&sat=-40" alt="Foto pemain RRQ Levi"><h3>RRQ LEVI</h3><a class="tiktok" href="https://www.tiktok.com/" target="_blank" rel="noopener">♪ &nbsp; Lihat TikTok →</a></article>
      <article class="player" data-name="btr luxy"><img class="photo" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=600&h=600&fit=crop&sat=-40" alt="Foto pemain BTR Luxy"><h3>BTR LUXY</h3><a class="tiktok" href="https://www.tiktok.com/" target="_blank" rel="noopener">♪ &nbsp; Lihat TikTok →</a></article>
    </div>
    <div class="empty" id="empty">Pemain tidak ditemukan.</div>
  </section>
  <footer id="about">FREE FIRE&nbsp; • &nbsp;ESPORTS&nbsp; • &nbsp;INDONESIA</footer>
</main>
<script>
const search=document.getElementById('search');
const cards=[...document.querySelectorAll('.player')];
const empty=document.getElementById('empty');
search.addEventListener('input',()=>{
  const q=search.value.trim().toLowerCase();let shown=0;
  cards.forEach(card=>{const match=card.dataset.name.includes(q);card.style.display=match?'':'none';if(match)shown++;});
  empty.style.display=shown?'none':'block';
});
</script>
</body>
</html> 