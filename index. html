
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080606">
<title>Free Fire Player Database</title>

<style>
:root {
  --red: #f01925;
  --bg: #080707;
  --card: #151011;
  --muted: #aaa;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  min-height: 100vh;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(ellipse at 50% 0%, #3b080d 0%, transparent 48%),
    radial-gradient(ellipse at 100% 80%, #260609 0%, transparent 35%),
    var(--bg);
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }

.topbar {
  min-height: 68px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(8,7,7,.94);
  border-bottom: 1px solid #641018;
  backdrop-filter: blur(12px);
}

.brand {
  color: var(--red);
  font-size: 21px;
  font-weight: 900;
  white-space: nowrap;
}

.brand span { color: white; }

nav {
  display: flex;
  align-items: center;
  gap: 24px;
  font-size: 13px;
  color: #ddd;
}

nav a:hover { color: var(--red); }

.follow {
  border: 1px solid var(--red);
  border-radius: 30px;
  padding: 10px 16px;
  font-size: 12px;
  font-weight: bold;
  white-space: nowrap;
}

main {
  width: min(1100px, 92%);
  margin: auto;
  padding-top: 28px;
}

.hero {
  min-height: 230px;
  border: 1px solid #a71924;
  border-radius: 17px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background:
    linear-gradient(120deg, #36080d, #100909 50%, #35070b);
  box-shadow: 0 0 35px #e7192725;
  position: relative;
  overflow: hidden;
  padding: 25px 12px;
}

.hero:before {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    125deg,
    transparent 0 90px,
    #ff263512 92px,
    transparent 96px 180px
  );
}

.crown {
  color: var(--red);
  font-size: 32px;
  margin-bottom: 8px;
  position: relative;
}

.hero h1 {
  margin: 0;
  font-size: clamp(34px, 7vw, 65px);
  font-weight: 1000;
  font-style: italic;
  letter-spacing: 2px;
  position: relative;
  text-shadow: 0 0 25px #f0192566;
}

.hero h1 span { color: var(--red); }

.hero p {
  color: #ff3541;
  font-size: clamp(14px, 3vw, 23px);
  font-weight: 900;
  letter-spacing: 4px;
  margin: 7px 0 0;
  position: relative;
}

.hero small {
  color: #aaa;
  margin-top: 12px;
  letter-spacing: 2px;
  font-size: 10px;
  position: relative;
}

.search-wrap {
  max-width: 580px;
  height: 50px;
  margin: 30px auto 42px;
  display: flex;
  border: 1px solid #574044;
  border-radius: 12px;
  overflow: hidden;
  background: #100c0d;
}

.search-wrap input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  padding: 0 16px;
  font-size: 14px;
}

.search-wrap button {
  width: 58px;
  border: 0;
  color: white;
  background: var(--red);
  font-size: 22px;
  cursor: pointer;
}

.section-title {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
}

.section-title:before,
.section-title:after {
  content: "";
  height: 2px;
  flex: 1;
  max-width: 120px;
  background: linear-gradient(90deg, transparent, var(--red));
}

.section-title:after { transform: scaleX(-1); }

.section-title h2 {
  margin: 0;
  padding: 11px 24px;
  border: 1px solid #a71924;
  border-radius: 5px;
  background: #1c090c;
  font-size: clamp(15px, 3vw, 22px);
  font-style: italic;
  letter-spacing: 1px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.player {
  background: linear-gradient(145deg, #211315, #100c0d);
  border: 1px solid #57151c;
  border-radius: 12px;
  padding: 9px;
  transition: .25s;
  box-shadow: 0 8px 20px #0008;
}

.player:hover {
  transform: translateY(-5px);
  border-color: var(--red);
  box-shadow: 0 8px 25px #f0192533;
}

.photo {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 8px;
  background: #25090c;
}

.player h3 {
  text-align: center;
  font-size: 15px;
  margin: 14px 2px;
  font-weight: 900;
  font-style: italic;
}

.tiktok {
  display: block;
  width: max-content;
  max-width: 100%;
  margin: 0 auto 5px;
  padding: 9px 15px;
  border: 1px solid var(--red);
  border-radius: 25px;
  font-size: 12px;
  transition: .2s;
}

.tiktok:hover {
  background: var(--red);
}

.empty {
  display: none;
  text-align: center;
  color: #aaa;
  padding: 35px 10px;
}

.about {
  margin-top: 65px;
  padding: 30px 20px;
  text-align: center;
  border-top: 1px solid #501018;
  border-bottom: 1px solid #501018;
  background: #100b0c;
}

.about h2 {
  color: var(--red);
  font-size: 21px;
}

.about p {
  color: #aaa;
  line-height: 1.8;
  font-size: 13px;
}

footer {
  padding: 25px 10px;
  text-align: center;
  color: #999;
  font-size: 11px;
  letter-spacing: 2px;
}

@media(max-width:650px) {
  .topbar {
    padding: 0 13px;
    min-height: 58px;
  }

  .brand { font-size: 16px; }

  nav {
    gap: 10px;
    font-size: 11px;
  }

  nav a:nth-child(3),
  nav a:nth-child(4) { display: none; }

  .follow {
    padding: 8px 10px;
    font-size: 10px;
  }

  main { width: 94%; }

  .hero { min-height: 165px; }

  .search-wrap { margin: 22px auto 32px; }

  .grid { gap: 11px; }

  .player { padding: 5px; }

  .player h3 {
    font-size: 11px;
    margin: 9px 1px;
  }

  .tiktok {
    font-size: 10px;
    padding: 7px 8px;
  }

  .section-title h2 { padding: 9px 12px; }

  .about { margin-top: 40px; }
}

@media(max-width:360px) {
  .grid { gap: 7px; }
  .player { padding: 4px; }
  .player h3 { font-size: 10px; }
  .tiktok { font-size: 9px; padding: 6px 5px; }
}
</style>
</head>

<body>

